{
    "name": "@turbodocx/n8n-nodes-turbodocx",
    "version": "1.3.1",
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "description": "n8n node for TurboDocx API - document & presentation generation, TurboSign e-signatures, TurboQuote CPQ, TurboPartner management, and webhooks",
    "license": "MIT",
    "homepage": "https://turbodocx.com",
    "keywords": [
        "n8n-community-node-package",
        "n8n",
        "turbodocx",
        "turbosign",
        "esignature",
        "e-signature",
        "digital-signature",
        "electronic-signature",
        "pdf-signature",
        "document-signing",
        "pdf",
        "signatures",
        "documents",
        "docx",
        "html-to-docx",
        "document-generation",
        "document-automation",
        "workflow",
        "automation",
        "api",
        "pptx",
        "presentations",
        "templates",
        "word",
        "powerpoint"
    ],
    "author": {
        "name": "TurboDocx",
        "email": "team@turbodocx.com"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/TurboDocx/n8n-nodes-turbodocx.git"
    },
    "scripts": {
        "build": "n8n-node build",
        "build:watch": "tsc --watch",
        "dev": "n8n-node dev",
        "lint": "n8n-node lint",
        "lint:fix": "n8n-node lint --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "release": "n8n-node release",
        "prepublishOnly": "npm run build"
    },
    "files": [
        "dist"
    ],
    "n8n": {
        "n8nNodesApiVersion": 1,
        "strict": true,
        "credentials": [
            "dist/credentials/TurboDocxApi.credentials.js",
            "dist/credentials/TurboDocxPartnerApi.credentials.js"
        ],
        "nodes": [
            "dist/nodes/TurboDocx/TurboDocx.node.js",
            "dist/nodes/TurboDocxTrigger/TurboDocxTrigger.node.js"
        ]
    },
    "devDependencies": {
        "@n8n/node-cli": "*",
        "@types/jest": "^29.5.14",
        "@types/node": "^24.10.1",
        "eslint": "9.32.0",
        "jest": "^29.7.0",
        "prettier": "3.6.2",
        "release-it": "^19.0.4",
        "ts-jest": "^29.2.5",
        "typescript": "5.9.2"
    },
    "peerDependencies": {
        "n8n-workflow": "*"
    },
    "overrides": {
        "@isaacs/brace-expansion": "^5.0.1",
        "ajv": "^6.15.0",
        "basic-ftp": "^5.3.1",
        "brace-expansion@1": "^1.1.18",
        "brace-expansion@2": "^2.1.4",
        "defu": "^6.1.7",
        "eslint-plugin-import-x": {
            "minimatch": "^9.0.9"
        },
        "flatted": "^3.4.4",
        "form-data": "^4.0.6",
        "glob@11": "^11.1.0",
        "handlebars": "^4.7.9",
        "ip-address": "^10.5.0",
        "js-yaml@3": "^3.15.1",
        "js-yaml@4": "^4.3.1",
        "lodash": "^4.18.1",
        "minimatch@10": "^10.2.6",
        "minimatch@3": "^3.1.5",
        "minimatch@5": "^5.1.9",
        "minimatch@9": "^9.0.9",
        "picomatch@2": "^2.3.2",
        "picomatch@4": "^4.0.5",
        "undici": "^6.28.0"
    }
}
